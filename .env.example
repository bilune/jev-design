# The Jev API key the design engine calls from the server.
# Docs: https://docs.typesafe.ai/sdk/javascript
# The key never reaches the browser; the SDK runs server side only.
TYPESAFE_API_KEY=

# Which way the questions reach the model. "direct" (the default) calls
# api.typesafe.ai with the key above. "gateway" routes them through Vercel's
# AI Gateway instead, which bills the Vercel account and needs its key rather
# than the TypeSafe one.
# JEV_ROUTE=gateway
# AI_GATEWAY_API_KEY=

# What one visitor, and everyone together, may spend on the endpoint.
# The defaults are 8 generations per address and 240 in total, per 10 minutes.
# RATE_LIMIT_PER_IP=8
# RATE_LIMIT_GLOBAL=240
# RATE_LIMIT_WINDOW_MS=600000
